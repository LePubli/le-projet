# ==============================================================================
# TriMaint — variables d'environnement (modèle, sans aucun secret)
# Copier en .env (ignoré par Git) pour le docker-compose local, ou coller dans
# « Environment Variables » d'un Git Deploy DockPanel (bouton « Paste .env »).
# Ne JAMAIS committer un vrai .env.
# ==============================================================================

# --- Base PostgreSQL (docker-compose : conteneur "postgres") -------------------
POSTGRES_DB=trimaint
POSTGRES_USER=trimaint
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_long_et_aleatoire

# --- Backend : obligatoires ----------------------------------------------------
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGER_MOI_cle_secrete_aleatoire
# Compose : postgresql://UTILISATEUR:MOT_DE_PASSE@postgres:5432/BASE
# Git Deploy : adresse de la base vue depuis le conteneur (voir README)
DATABASE_URL=postgresql://trimaint:CHANGER_MOI@postgres:5432/trimaint
# Origine(s) autorisée(s) par le CORS, séparées par des virgules
ALLOWED_ORIGINS=https://triselec.le-publicitaire.fr

# --- Backend : réglages (valeurs par défaut) -----------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE=62914560
ACCESS_TOKEN_EXPIRE_MINUTES=480
GUNICORN_WORKERS=2
LOGIN_RATE_LIMIT=5/minute
LOG_FORMAT=json
LOG_LEVEL=INFO

# Création d'un compte admin au premier démarrage d'une base vierge.
# Laisser à 0 sur une base qui contient déjà des comptes.
BOOTSTRAP_ADMIN=0
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Sauvegarde automatique de la base (cron dans le conteneur backend) --------
BACKUP_ENABLED=1
BACKUP_HOUR=02
BACKUP_MINUTE=00
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/data/backups

# --- Optionnel : e-mails et notifications push (désactivés si vides) -----------
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# --- Frontend, Git Deploy uniquement -------------------------------------------
# Adresse publique du backend (sans slash final) et nom de domaine envoyé en
# en-tête Host. Absents du compose : l'image utilise http://backend:8000.
# BACKEND_UPSTREAM=https://api-triselec.le-publicitaire.fr
# BACKEND_HOST_HEADER=api-triselec.le-publicitaire.fr
